---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Modes from '../components/Modes.astro';
import Bring from '../components/Bring.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import Refuse from '../components/Refuse.astro';
import Faq from '../components/Faq.astro';
import SectionPlaceholder from '../components/SectionPlaceholder.astro';
import { SECTIONS } from '../config';
---

<Base>
  <Hero />
  <Why />
  <Modes />
  <Bring />
  <SectionPlaceholder
    id={SECTIONS.howItWorks}
    heading="Here's exactly what will happen when you show up"
    note="How it works: mode toggle, 7-step click-through, phone mockup."
  />
  <WhatYouGet />
  <Refuse />
  <Faq />
  <SectionPlaceholder
    id={SECTIONS.waitlist}
    heading="Got an idea you're completely sure about? Perfect."
    note="Waitlist form, posting to the external form service."
  />
</Base>
