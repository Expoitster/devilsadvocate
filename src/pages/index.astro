---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Modes from '../components/Modes.astro';
import Bring from '../components/Bring.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import Refuse from '../components/Refuse.astro';
import Faq from '../components/Faq.astro';
import Pricing from '../components/Pricing.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Waitlist from '../components/Waitlist.astro';
import { WAITLIST_ON } from '../config';
---

<Base>
  <Hero />
  <Why />
  <Modes />
  <Bring />
  <HowItWorks />
  <WhatYouGet />
  <Pricing />
  <Refuse />
  <Faq />
  {WAITLIST_ON && <Waitlist />}
</Base>
