---
import JourneyShot from './JourneyShot.astro';
import { MODES, MODE_LABEL, STEPS } from '../data/journey';
import { SECTIONS } from '../config';
---

<section id={SECTIONS.howItWorks} aria-labelledby="journey-heading" class="section container-page">
  <h2 id="journey-heading" class="max-w-[20ch]">Here’s exactly what will happen when you show up</h2>

  <!--
    Without JavaScript this is a plain ordered list: every step, its text,
    and its idea-mode mockup, stacked. journey.ts turns it into a stepper,
    with a sticky phone beside the list on desktop.
  -->
  <div class="journey" data-journey>
    <fieldset class="journey__modes" data-modes hidden>
      <legend class="sr-only-text">Example to show</legend>
      {
        MODES.map((mode) => (
          <label class="journey__mode">
            <input type="radio" name="journey-mode" value={mode} checked={mode === 'idea'} />
            <span>{MODE_LABEL[mode]}</span>
          </label>
        ))
      }
    </fieldset>

    <p class="sr-only-text" aria-live="polite" data-live></p>

    <div class="journey__body">
      <div class="journey__main">
        <ol class="journey__steps" role="list" data-steps>
          {
            STEPS.map((step, i) => (
              <li class="step" data-step={i + 1}>
                <h3 class="step__heading" data-step-heading>
                  <span class="step__num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="sr-only-text">Step {i + 1}: </span>
                  <span class="step__title">{step.title}</span>
                </h3>
                <div class="step__panel" id={`journey-step-${i + 1}`}>
                  <p class="step__body">{step.body}</p>
                  <div class="journey__slot" data-shot-slot>
                    {MODES.map((mode) => (
                      <JourneyShot step={i + 1} mode={mode} />
                    ))}
                  </div>
                  <div data-nav-slot />
                </div>
              </li>
            ))
          }
        </ol>

        <div data-nav-home>
          <div class="journey__nav" data-nav hidden>
            <button type="button" class="journey__back" data-back>Back</button>
            <p class="journey__count" data-count aria-hidden="true">Step 1 of 7</p>
            <button type="button" class="btn-primary journey__next" data-next>Next</button>
          </div>
        </div>
      </div>

      <div class="journey__stage" data-stage></div>
    </div>
  </div>
</section>

<script>
  import { initJourney } from '../scripts/journey';
  initJourney();
</script>

<style is:global>
  /* ---------------------------------------------------------------- */
  /* Base: the no-JavaScript list, which is also the phone layout.     */
  /* ---------------------------------------------------------------- */

  .journey {
    margin-top: 2.5rem;
  }

  .journey__steps {
    display: grid;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-bottom: 2rem;
  }

  /* The rail that joins one number to the next. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 2.25rem;
    bottom: 0;
    left: calc(1.125rem - 0.75px);
    width: 1.5px;
    background: var(--rule);
  }

  /* The heading spans both columns; with JS a button fills it. Both lay
     out the same way, so the page doesn't shift when it enhances. */
  .step__heading {
    grid-column: 1 / -1;
    display: flex;
  }
  .step__heading,
  .step__head {
    align-items: center;
    gap: 1rem;
  }

  .step__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--ink-muted);
    border-radius: 50%;
    background: var(--paper);
    font-family: var(--font-product);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
  }

  .step__title {
    font-family: var(--font-product);
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.25;
  }

  .step__panel {
    grid-column: 2;
    padding-top: 0.5rem;
  }

  .step__body {
    max-width: 52ch;
  }

  /* The phone sits under the step. On narrow screens it takes the full
     width, rather than hanging off the number rail. */
  .journey__slot {
    display: grid;
    margin-top: 1.5rem;
    margin-left: calc(-3.25rem);
  }
  @media (min-width: 30rem) {
    .journey__slot {
      margin-left: 0;
    }
  }
  .journey__slot > .shot,
  .journey__stage > .shot {
    grid-area: 1 / 1;
    min-width: 0;
  }

  /* Every mockup stretches to the tallest one sharing its grid cell, so
     the phone frame never changes size; only what's on screen does. */
  .journey .shot,
  .journey .shot .phone,
  .journey .shot .phone__bezel {
    display: flex;
    flex-direction: column;
  }
  .journey .shot .phone,
  .journey .shot .phone__bezel,
  .journey .shot .phone__screen {
    flex: 1;
  }

  /* On phones the mockup sits inline in a long page: keep it compact. */
  @media (max-width: 63.999rem) {
    .journey .shot .phone__screen {
      min-height: 24rem;
    }
  }

  /* Mode toggle: a real radio group, styled as two halves. */
  .journey__modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 30rem;
    margin: 0 0 2.5rem;
    padding: 0.25rem;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius-control) + 0.25rem);
    background: var(--surface);
  }
  .journey__mode {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 3rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-control);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
  }
  .journey__mode input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .journey__mode:has(input:checked) {
    background: var(--ink);
    color: var(--paper);
  }
  .journey__mode:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  /* Back / step count / Next */
  .journey__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .journey__nav[hidden] {
    display: none;
  }
  .journey__back {
    min-height: 3rem;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-control);
    font-weight: 600;
    cursor: pointer;
  }
  /* At either end, the control that can't go further steps aside but
     keeps its space, so the row doesn't jump. */
  .journey__back[aria-disabled='true'],
  .journey__next[aria-disabled='true'] {
    visibility: hidden;
  }
  .journey__count {
    font-size: var(--step--1);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Narrow phones: the controls use the phone's full width, and the
     count gives way (the numbered rail already shows where you are). */
  @media (max-width: 29.999rem) {
    [data-nav-slot] .journey__nav {
      margin-left: -3.25rem;
    }
    .journey__count {
      display: none;
    }
  }
  .journey__next {
    cursor: pointer;
  }

  /* ---------------------------------------------------------------- */
  /* Enhanced: a stepper. Shared by phone and desktop.                 */
  /* ---------------------------------------------------------------- */

  .journey[data-enhanced] .step__head {
    display: flex;
    width: 100%;
    min-height: 2.75rem;
    text-align: left;
    cursor: pointer;
  }
  .journey[data-enhanced] .step__head:focus-visible {
    outline: none;
  }
  .journey[data-enhanced] .step__head:focus-visible .step__num {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .journey[data-enhanced] .step__head:focus-visible .step__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .journey[data-enhanced] .step__head:hover .step__title {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .journey[data-enhanced] .step {
    padding-bottom: 1.25rem;
  }
  .journey[data-enhanced] .step[data-state='done'] .step__num {
    border-color: var(--ink);
  }
  .journey[data-enhanced] .step[data-state='active'] .step__num {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* Only the chosen mode's mockup shows. Hidden mockups keep their place
     in the grid cell, so swapping never changes the height. */
  .journey[data-enhanced] .shot:not([data-visible]) {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .journey[data-ready] .shot {
      transition:
        opacity 220ms ease,
        visibility 0s linear 220ms;
    }
    .journey[data-ready] .shot[data-visible] {
      transition:
        opacity 220ms ease,
        visibility 0s;
    }
  }

  /* Phone layout: one step open at a time. */
  @media (max-width: 63.999rem) {
    .journey[data-enhanced] .step:not([data-state='active']) .step__panel {
      display: none;
    }
    .journey[data-enhanced] .step:not([data-state='active']) .step__title {
      color: var(--ink-muted);
    }
  }
  @media (max-width: 63.999rem) and (prefers-reduced-motion: no-preference) {
    .journey[data-ready] .step[data-state='active'] .step__panel {
      transition: opacity 220ms ease;
    }
    @starting-style {
      .journey[data-ready] .step[data-state='active'] .step__panel {
        opacity: 0;
      }
    }
  }

  /* ---------------------------------------------------------------- */
  /* Desktop: steps on the left, one sticky phone on the right.        */
  /* ---------------------------------------------------------------- */

  @media (min-width: 64rem) {
    .journey[data-enhanced] .journey__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 22rem;
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .journey[data-enhanced] .journey__stage {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      display: grid;
      justify-items: center;
    }

    .journey[data-enhanced] .step {
      padding-bottom: 1.5rem;
      cursor: pointer;
    }
    .journey[data-enhanced] .step__panel {
      padding-top: 0.375rem;
    }
    .journey[data-enhanced] .journey__slot {
      display: none;
    }
    .journey[data-enhanced] .step:not([data-state='active']) .step__body {
      color: var(--ink-muted);
    }
    .journey[data-enhanced] .journey__nav {
      max-width: 36rem;
      margin-left: 3.25rem;
    }
  }
</style>
