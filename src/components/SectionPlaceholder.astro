---
/**
 * Temporary scaffold for a page section: the anchor id, the heading from
 * docs/copy.md, and an empty, visibly marked slot where the section goes.
 * Replace each one as its section is built.
 */
interface Props {
  id: string;
  heading: string;
  level?: 1 | 2;
  /** What will be built here, shown inside the empty slot. */
  note: string;
}

const { id, heading, level = 2, note } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section id={id} aria-labelledby={`${id}-heading`} class="container-page py-[calc(var(--section-gap)/2)]">
  <Heading id={`${id}-heading`} class="max-w-[20ch]">{heading}</Heading>
  <div class="mt-8 max-w-measure rounded-control border border-dashed border-rule px-5 py-10 text-ink-muted">
    <p class="text-step-n1">Placeholder. {note}</p>
  </div>
</section>
