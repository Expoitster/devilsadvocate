---
import type { HTMLAttributes } from 'astro/types';

/**
 * The user's voice: Bricolage Grotesque, flush left, teal speech mark.
 * Pass `speaker={false}` where the context already says whose line it is
 * (an FAQ question, for example) so screen readers don't hear it twice.
 */
interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  /** Use `span` inside phrasing-only parents such as <summary>. */
  as?: 'div' | 'li' | 'span';
  bodyAs?: 'p' | 'div' | 'span';
  size?: 'sm' | 'md' | 'lg';
  speaker?: string | false;
  class?: string;
}

const { as: Tag = 'div', bodyAs: Body = 'p', size = 'md', speaker = 'You', class: className, ...rest } = Astro.props;
---

<Tag {...rest} class:list={['line', 'line--user', `line--${size}`, className]}>
  <span class="line__mark" aria-hidden="true">“</span>
  <Body class="line__body">{speaker && <span class="sr-only-text">{speaker}: </span>}<slot /></Body>
</Tag>
