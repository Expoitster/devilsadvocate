---
/**
 * The waitlist. The form is the user's voice (Bricolage, teal choices);
 * the reply after joining is the product's (a ProductLine). Signups go
 * straight from the browser into the Supabase `waitlist` table, which the
 * public can add to but not read. See supabase/waitlist.sql. The values
 * sent for role and interests are the labels, as the table's checks expect.
 */
import ProductLine from './ProductLine.astro';
import { SECTIONS, path } from '../config';

const ROLES = ['MBA student', 'First-time founder', 'Working professional', 'Just curious'];
const INTERESTS = ['A startup idea', 'A life decision', 'A work proposal', 'A belief I want to test'];

const check = `<svg class="chip__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section id={SECTIONS.waitlist} aria-labelledby="waitlist-heading" class="section container-page">
  <div class="split">
    <div>
      <h2 id="waitlist-heading" class="max-w-[16ch]">Got an idea you’re completely sure about? Perfect.</h2>
      <p class="waitlist__sub">Join the waitlist. We’ll argue with you on December 1.</p>
    </div>

    <div>
      <form class="waitlist" data-waitlist novalidate>
        <div class="field">
          <label for="wl-email" class="field__label">Email</label>
          <input
            id="wl-email"
            class="field__input"
            type="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="wl-email-error"
          />
          <p id="wl-email-error" class="field__error" data-email-error hidden>
            That email looks off. Check for typos and try again.
          </p>
        </div>

        <div class="field">
          <label for="wl-name" class="field__label">First name <span class="field__opt">(optional)</span></label>
          <input id="wl-name" class="field__input" type="text" name="first_name" autocomplete="given-name" maxlength="80" />
        </div>

        <fieldset class="field">
          <legend class="field__label">I am a <span class="field__opt">(pick one)</span></legend>
          <div class="chips">
            {
              ROLES.map((role) => (
                <label class="chip">
                  <input type="radio" name="role" value={role} />
                  <Fragment set:html={check} />
                  <span>{role}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="field">
          <legend class="field__label">What would you bring first? <span class="field__opt">(pick any)</span></legend>
          <div class="chips">
            {
              INTERESTS.map((interest) => (
                <label class="chip">
                  <input type="checkbox" name="interests" value={interest} />
                  <Fragment set:html={check} />
                  <span>{interest}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="wl-challenge" class="field__label">
            The idea or decision you’d bring <span class="field__opt">(optional)</span>
          </label>
          <input
            id="wl-challenge"
            class="field__input"
            type="text"
            name="first_challenge"
            maxlength="280"
            placeholder="e.g. I’m skipping placements to start a pet-food brand"
          />
        </div>

        <div class="field">
          <div class="consent">
            <label class="consent__label">
              <input
                type="checkbox"
                name="consent"
                class="consent__box"
                required
                aria-describedby="wl-consent-error"
                data-consent
              />
              <span>Email me about the Devils Advocate beta. Unsubscribe anytime.</span>
            </label>
            <a class="link-quiet consent__privacy" href={path('/privacy/')}>Privacy</a>
          </div>
          <p id="wl-consent-error" class="field__error" data-consent-error hidden>
            Tick the box so we can email you about the beta.
          </p>
        </div>

        {/* Left empty by people, filled in by bots; a filled one is dropped. */}
        <div class="waitlist__trap" aria-hidden="true">
          <label>Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="waitlist__actions">
          <button type="submit" class="btn-primary" data-submit>Join the waitlist</button>
        </div>

        <p class="waitlist__status" role="status" aria-live="polite" data-status></p>

        <noscript>
          <p class="waitlist__status">Please enable JavaScript to join the waitlist.</p>
        </noscript>
      </form>

      {/* After joining, the product answers. A repeat signup gets its own line. */}
      <div class="waitlist__done" data-done tabindex="-1" hidden>
        <ProductLine size="lg" data-done-joined>
          You’re in. We’ll email you before the beta opens on December 1. Until then, practice: doubt one thing you
          believed this morning.
        </ProductLine>
        <ProductLine size="lg" data-done-already hidden>You’re already on the list. Eager. We respect it.</ProductLine>
      </div>
    </div>
  </div>
</section>

<script>
  import { initWaitlist } from '../scripts/waitlist';
  initWaitlist();
</script>

<style>
  .waitlist__sub {
    margin-top: 1.25rem;
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .waitlist {
    display: grid;
    gap: 1.75rem;
    max-width: 36rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field__label {
    padding: 0;
    font-weight: 600;
    line-height: 1.35;
  }
  .field__opt {
    font-weight: 400;
    color: var(--ink-muted);
  }

  /* 17px or more, so iOS doesn't zoom into the field on focus. */
  .field__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid var(--ink-muted);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: max(1.0625rem, var(--step-0));
  }
  .field__input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
  .field__input[aria-invalid='true'] {
    border-color: var(--devil);
    border-width: 2px;
  }

  .field__error {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--devil);
  }

  /* Choices are the user's voice: teal when picked, plus a tick, so the
     state never relies on color alone. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1.5px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 500;
    line-height: 1.25;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip :global(.chip__check) {
    display: none;
    color: var(--you);
  }
  .chip:has(input:checked) {
    border-color: var(--you);
    background: color-mix(in srgb, var(--you) 10%, var(--surface));
  }
  .chip:has(input:checked) :global(.chip__check) {
    display: block;
  }
  .chip:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .chip:hover {
    border-color: var(--ink-muted);
  }

  .waitlist__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .waitlist__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .waitlist__actions button[aria-busy='true'] {
    cursor: progress;
    opacity: 0.8;
  }

  /* Consent: a real checkbox (teal when ticked), its sentence, and the
     privacy link beside it. The whole label is the tap target. */
  .consent {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .consent__label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-top: 0.25rem;
    cursor: pointer;
  }
  .consent__box {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2em;
    accent-color: var(--you);
    cursor: pointer;
  }
  .consent__box[aria-invalid='true'] {
    outline: 2px solid var(--devil);
    outline-offset: 2px;
  }
  .consent__privacy {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .waitlist__status:empty {
    display: none;
  }
  .waitlist__status {
    font-weight: 500;
    color: var(--devil);
  }

  .waitlist__done {
    max-width: 36rem;
    outline: none;
  }
</style>
