---
/**
 * One static phone mockup: what the user would see at one step of the
 * journey, in one mode. Nothing in here is a working control.
 */
import PhoneFrame from './PhoneFrame.astro';
import UserLine from './UserLine.astro';
import ProductLine from './ProductLine.astro';
import Receipt from './Receipt.astro';
import { EXAMPLES, MODE_LABEL, MODES, STEPS, type Mode } from '../data/journey';

interface Props {
  step: number; // 1-7
  mode: Mode;
}

const { step, mode } = Astro.props;
const ex = EXAMPLES[mode];
const label = `Mockup of step ${step}, ${STEPS[step - 1]!.title.replace(/\.$/, '')}, ${mode} example`;
---

<div class="shot" data-shot data-shot-step={step} data-mode={mode} hidden={mode !== 'idea'}>
  <PhoneFrame label={label} subtitle={step === 1 ? undefined : MODE_LABEL[mode]}>
    {
      step === 1 && (
        <div class="modes">
          {MODES.map((m) => (
            <div class:list={['mode-option', { 'is-chosen': m === mode }]}>
              <span>{MODE_LABEL[m]}</span>
              {m === mode && (
                <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="currentColor" />
                  <path d="M5.8 10.4l2.7 2.7 5.7-6" fill="none" stroke="var(--surface)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {m === mode && <span class="sr-only-text">(chosen)</span>}
            </div>
          ))}
        </div>
      )
    }

    {
      step === 2 && (
        <>
          <p class="ui-label">Transcript</p>
          <UserLine size="sm">{ex.transcript}</UserLine>
        </>
      )
    }

    {
      step === 3 && (
        <>
          <UserLine size="sm">{ex.transcript}</UserLine>
          {ex.questions.map((q) => (
            <ProductLine size="sm">{q}</ProductLine>
          ))}
        </>
      )
    }

    {
      step === 4 && (
        <>
          <UserLine size="sm">{ex.transcript}</UserLine>
          <ProductLine size="sm" bodyAs="div">
            {ex.realQuestion.map((part) => (
              <p>
                <strong class="lead">{part.lead}</strong> {part.text}
              </p>
            ))}
          </ProductLine>
        </>
      )
    }

    {
      step === 5 && (
        <>
          <p class="ui-label">The case for you</p>
          <ProductLine size="sm">{ex.caseFor}</ProductLine>
          <p class="ui-label ui-label--gap">The other side</p>
          <ProductLine size="sm" bodyAs="div">
            <ul class="receipts" role="list">
              {ex.receipts.map((r) => (
                <li>
                  <Receipt>{r.source}</Receipt>
                  <p>{r.point}</p>
                </li>
              ))}
            </ul>
          </ProductLine>
          <p class="note">{ex.otherSideNote}</p>
        </>
      )
    }

    {
      step === 6 && (
        <>
          <UserLine size="sm">{ex.pushback}</UserLine>
          <ProductLine size="sm">{ex.reply}</ProductLine>
        </>
      )
    }

    {
      step === 7 && (
        <div class="mini-card">
          <p class="mini-card__title">Hand-back card</p>
          <div class="mini-card__part">
            <p class="ui-label">Your position</p>
            <UserLine size="sm" speaker={false}>
              {ex.transcript}
            </UserLine>
          </div>
          <div class="mini-card__part">
            <p class="ui-label">Toughest counterpoints</p>
            <ul class="mini-card__chips" role="list">
              {ex.card.counterpoints.map((c) => (
                <li>
                  <Receipt>{c}</Receipt>
                </li>
              ))}
            </ul>
          </div>
          <div class="mini-card__part">
            <p class="ui-label">Cheapest test this month</p>
            <p class="mini-card__test">{ex.card.test}</p>
          </div>
          <p class="mini-card__foot">Your call. Always.</p>
        </div>
      )
    }

    {
      step === 2 && (
        <div slot="bottom" class="mic" aria-hidden="true">
          <span class="mic__button">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" />
            </svg>
          </span>
        </div>
      )
    }
  </PhoneFrame>
</div>

<style>
  .ui-label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink-muted);
  }
  .ui-label--gap {
    margin-top: 0.5rem;
  }

  .note {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .lead {
    font-weight: 600;
  }

  /* Step 1 */
  .modes {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.25rem;
  }
  .mode-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid var(--rule);
    border-radius: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .mode-option.is-chosen {
    border-color: var(--you);
    color: var(--you);
    background: color-mix(in srgb, var(--you) 8%, var(--surface));
  }
  .mode-option.is-chosen span {
    color: var(--ink);
  }

  /* Step 2: the mic is a picture of a button, not a button. */
  .mic {
    display: flex;
    justify-content: center;
  }
  .mic__button {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--you);
    color: var(--surface);
    box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--you) 16%, transparent);
  }

  /* Step 5 */
  .receipts {
    display: grid;
    gap: 0.75rem;
  }
  .receipts p {
    margin-top: 0.25rem;
  }

  /* Step 7 */
  .mini-card {
    overflow: hidden;
    border: 1.5px solid var(--ink);
    border-radius: 0.75rem;
  }
  .mini-card__title {
    padding: 0.625rem 0.875rem;
    background: var(--ink);
    color: var(--surface);
    font-family: var(--font-product);
    font-size: 1.1875rem;
    font-weight: 580;
    line-height: 1.2;
  }
  .mini-card__part {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 0.875rem;
  }
  .mini-card__part + .mini-card__part {
    border-top: 1px dashed color-mix(in srgb, var(--ink) 28%, transparent);
  }
  .mini-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .mini-card__test {
    font-family: var(--font-product);
    font-size: 1rem;
    line-height: 1.45;
  }
  .mini-card__foot {
    padding: 0.5rem 0.875rem;
    border-top: 1.5px solid var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: right;
  }
</style>
