# Copy to .env for local builds, and set the same variables in your host's
# dashboard (Vercel: Settings > Environment Variables; Netlify: Site
# configuration > Environment variables).

# Your public address, no trailing slash. Used for canonical links, the
# share image URL, and sitemap.xml. On Netlify and Vercel the build falls
# back to the host's own URL if this is unset.
SITE_URL=https://www.example.com

# Only when serving from a sub-path (the GitHub Pages workflow sets it).
# BASE_PATH=/devilsadvocate

# The waitlist form's endpoint (Formspree-style) and the contact address
# shown in the FAQ and on /privacy. Until set, the page shows {{...}}.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id
PUBLIC_CONTACT_EMAIL=hello@example.com
